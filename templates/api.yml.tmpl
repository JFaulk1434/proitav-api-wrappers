module: device
description: Telnet API commands for {{PRODUCT_MODEL}}

schema:
  command:
    required:
      - command
      - syntax
      - description
      - response
    properties:
      command: string
      syntax: string
      description: string
      parameters: list
      response:
        type: string
        schema: object

commands:
  firmware_version:
    command: "GET VER"
    syntax: "GET VER"
    description: "Get the firmware version"
    parameters: []
    response:
      type: string
      schema:
        firmware: string

  example_get_set_pair:
    get:
      command: "GET EXAMPLE"
      syntax: "GET EXAMPLE"
      description: "Example read-style command placeholder"
      parameters: []
      response:
        type: string
        schema:
          value: string
    set:
      command: "SET EXAMPLE"
      syntax: "SET EXAMPLE <value>"
      description: "Example write-style command placeholder"
      parameters:
        - value
      response:
        type: confirmation
        schema: {}
